# Copia este archivo como .env y rellena con tu configuración de Firebase
# Firebase Console → Tu Proyecto → Configuración del Proyecto → Web App

VITE_FIREBASE_API_KEY=tu-api-key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# UID del administrador principal (lo encuentras en Firebase Auth después de tu primer login)
VITE_ADMIN_UID=uid-del-admin
